# Reference for every environment variable the service understands. All are
# optional; the values shown are the built-in defaults used when a variable is
# unset. docker-compose reads a copy named ".env"; for a bare `go run`, export
# the vars yourself (the app does not parse dotenv files).

# TCP port the HTTP server listens on.
PORT=8080

# Comma-separated list of browser origins allowed to call the API.
# Use "*" to allow any origin (development only).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP server timeouts (Go duration syntax: 300ms, 5s, 1m ...).
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s

# How long in-flight requests get to finish after SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=10s

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
