# Optional. Absolute origin of the calculator API.
#
# Leave unset for local development: the app makes relative requests to
# `/api/...` and Vite proxies them to http://localhost:8080 (see vite.config.ts).
# In the Docker setup, nginx proxies `/api` to the backend container, so this
# also stays unset there.
#
# Set it only when the API lives on a different origin than the frontend:
# VITE_API_BASE_URL=https://calculator-api.example.com
